@page
@model Agencia_Viajes_ADS.Pages.PaquetesModel
@{
    ViewData["Title"] = "Paquetes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Panel de Paquetes</h2>

    <button class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#modalCrear">
        + Nuevo Paquete
    </button>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Exito"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">

    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-semibold">Listado de Paquetes</h5>
    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>ID Tour</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Fecha Salida</th>
                        <th>Fecha Llegada</th>
                        <th>Plazas</th>
                        <th>Ocupadas</th>
                        <th>Precio</th>
                        <th>Escalas</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Paquetes.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4">
                                No existen paquetes registrados
                            </td>
                        </tr>
                    }

                    @foreach (var p in Model.Paquetes)
                    {
                        <tr>

                            <td>@p.IdTour</td>
                            <td>@p.NombreTour</td>
                            <td>@p.DescripcionTour</td>
                            <td>@p.FechaSalida.ToString("yyyy-MM-dd")</td>
                            <td>@p.FechaLlegada.ToString("yyyy-MM-dd")</td>
                            <td>@p.CantidadPlazas</td>
                            <td>@p.PlazasOcupadas</td>
                            <td>$@p.Precio.ToString("N2")</td>
                            <td>
                                @string.Join(" -> ", p.Escalas.OrderBy(e => e.Orden).Select(e => e.LugarEscala))
                            </td>

                            <td class="text-end">

                                <button class="btn btn-outline-primary btn-sm me-1"
                                        onclick="abrirEditar(
                                        '@p.IdTour',
                                        '@string.Join(", ", p.Escalas.OrderBy(e => e.Orden).Select(e => e.LugarEscala))',
                                        '@p.NombreTour',
                                        '@p.DescripcionTour',
                                        '@p.FechaSalida.ToString("yyyy-MM-dd")',
                                        '@p.FechaLlegada.ToString("yyyy-MM-dd")',
                                        '@p.CantidadPlazas',
                                        '@p.PlazasOcupadas',
                                        '@p.Precio'
                                        )">
                                    Editar
                                </button>

                                <form method="post"
                                      asp-page-handler="Eliminar"
                                      style="display:inline;">

                                    <input type="hidden"
                                           name="id"
                                           value="@p.IdTour" />

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('¿Eliminar paquete?')">
                                        Eliminar
                                    </button>
                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- MODAL CREAR -->

<div class="modal fade"
     id="modalCrear"
     tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Nuevo Paquete
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <form method="post"
                  asp-page-handler="Crear">

                <div class="modal-body row">

                    <div class="col-md-6 mb-3">
                        <label>ID Tour</label>

                        <input asp-for="TourForm.IdTour"
                               class="form-control"
                               required />
                        <span asp-validation-for="TourForm.IdTour" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Escalas (separadas por coma)</label>

                        <input asp-for="EscalasTexto"
                               class="form-control"
                               placeholder="Ej: Paris, Roma, Madrid" />

                    </div>

                    <div class="col-md-12 mb-3">

                        <label>Nombre Tour</label>

                        <input asp-for="TourForm.NombreTour"
                               class="form-control"
                               required />
                        <span asp-validation-for="TourForm.NombreTour" class="text-danger small"></span>

                    </div>

                    <div class="col-md-12 mb-3">

                        <label>Descripción</label>

                        <textarea asp-for="TourForm.DescripcionTour"
                                  class="form-control"></textarea>
                        <span asp-validation-for="TourForm.DescripcionTour" class="text-danger small"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Fecha Salida</label>

                        <input asp-for="TourForm.FechaSalida"
                               type="date"
                               id="createSalida"
                               class="form-control"
                               required />
                        <span asp-validation-for="TourForm.FechaSalida" class="text-danger small"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Fecha Llegada</label>

                        <input asp-for="TourForm.FechaLlegada"
                               type="date"
                               id="createLlegada"
                               class="form-control"
                               required />
                        <span asp-validation-for="TourForm.FechaLlegada" class="text-danger small"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Plazas Totales</label>

                        <input asp-for="TourForm.CantidadPlazas"
                               type="number"
                               class="form-control"
                               required />
                        <span asp-validation-for="TourForm.CantidadPlazas" class="text-danger small"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Plazas Ocupadas</label>

                        <input asp-for="TourForm.PlazasOcupadas"
                               type="number"
                               class="form-control"
                               required />
                        <span asp-validation-for="TourForm.PlazasOcupadas" class="text-danger small"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Precio del Tour</label>

                        <input asp-for="TourForm.Precio"
                               type="number"
                               step="0.01"
                               class="form-control"
                               required />
                        <span asp-validation-for="TourForm.Precio" class="text-danger small"></span>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- MODAL EDITAR -->

<div class="modal fade"
     id="modalEditar"
     tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Editar Paquete
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>

            </div>

            <form method="post"
                  asp-page-handler="Editar">

                <div class="modal-body row">

                    <div class="col-md-6 mb-3">

                        <label>ID Tour</label>

                        <input asp-for="TourForm.IdTour"
                               id="editIdTour"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Escalas (separadas por coma)</label>

                        <input asp-for="EscalasTexto"
                               id="editEscalas"
                               class="form-control" />

                    </div>

                    <div class="col-md-12 mb-3">

                        <label>Nombre</label>

                        <input asp-for="TourForm.NombreTour"
                               id="editNombre"
                               class="form-control" />
                        <span asp-validation-for="TourForm.NombreTour" class="text-danger small"></span>

                    </div>

                    <div class="col-md-12 mb-3">

                        <label>Descripción</label>

                        <textarea asp-for="TourForm.DescripcionTour"
                                  id="editDescripcion"
                                  class="form-control"></textarea>
                        <span asp-validation-for="TourForm.DescripcionTour" class="text-danger small"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Fecha Salida</label>

                        <input asp-for="TourForm.FechaSalida"
                               type="date"
                               id="editSalida"
                               class="form-control" />
                        <span asp-validation-for="TourForm.FechaSalida" class="text-danger small"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Fecha Llegada</label>

                        <input asp-for="TourForm.FechaLlegada"
                               type="date"
                               id="editLlegada"
                               class="form-control" />
                        <span asp-validation-for="TourForm.FechaLlegada" class="text-danger small"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Plazas Totales</label>

                        <input asp-for="TourForm.CantidadPlazas"
                               type="number"
                               id="editPlazas"
                               class="form-control" />
                        <span asp-validation-for="TourForm.CantidadPlazas" class="text-danger small"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Plazas Ocupadas</label>

                        <input asp-for="TourForm.PlazasOcupadas"
                               type="number"
                               id="editOcupadas"
                               class="form-control" />
                        <span asp-validation-for="TourForm.PlazasOcupadas" class="text-danger small"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Precio del Tour</label>

                        <input asp-for="TourForm.Precio"
                               type="number"
                               step="0.01"
                               id="editPrecio"
                               class="form-control" />
                        <span asp-validation-for="TourForm.Precio" class="text-danger small"></span>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Actualizar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

<partial name="_ValidationScriptsPartial" />

<script>

@if (!ViewData.ModelState.IsValid)
{
    <text>
    document.addEventListener("DOMContentLoaded", function() {
        var modal = new bootstrap.Modal(document.getElementById('modalCrear'));
        modal.show();
    });
    </text>
}

document.addEventListener("DOMContentLoaded", function() {
    // Configuración de fecha mínima para creación (Hoy)
    const now = new Date();
    const offset = now.getTimezoneOffset() * 60000;
    const localISODate = new Date(now - offset).toISOString().slice(0, 10);
    
    const createSalida = document.getElementById('createSalida');
    const createLlegada = document.getElementById('createLlegada');
    const editSalida = document.getElementById('editSalida');
    const editLlegada = document.getElementById('editLlegada');

    if (createSalida) {
        createSalida.min = localISODate;
        createSalida.addEventListener('change', function() {
            createLlegada.min = this.value;
            if (createLlegada.value && createLlegada.value < this.value) {
                createLlegada.value = this.value;
            }
        });
    }

    if (editSalida) {
        editSalida.addEventListener('change', function() {
            editLlegada.min = this.value;
            if (editLlegada.value && editLlegada.value < this.value) {
                editLlegada.value = this.value;
            }
        });
    }
});

function abrirEditar(id, escalas, nombre, descripcion, salida, llegada, plazas, ocupadas, precio)
{
    document.getElementById('editIdTour').value = id;
    document.getElementById('editEscalas').value = escalas;
    document.getElementById('editNombre').value = nombre;
    document.getElementById('editDescripcion').value = descripcion;
    document.getElementById('editSalida').value = salida;
    document.getElementById('editLlegada').value = llegada;
    document.getElementById('editPlazas').value = plazas;
    document.getElementById('editOcupadas').value = ocupadas;
    document.getElementById('editPrecio').value = precio;

    // Actualizar min de llegada al abrir editar
    document.getElementById('editLlegada').min = salida;

    new bootstrap.Modal(document.getElementById('modalEditar')).show();
}

</script>

}