@page
@model Agencia_Viajes_ADS.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Crear Cuenta";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExploraMundo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-container">
        <div class="login-header text-center">
            <div class="logo-box d-inline-flex align-items-center mb-4">
                <div class="logo-icon me-2">
                    <i class="bi bi-compass-fill"></i>
                </div>
                <span class="logo-text">ExploraMundo</span>
            </div>
            <h1 class="welcome-title">Únete a nosotros</h1>
            <p class="welcome-subtitle">Comienza tu viaje hoy mismo</p>
        </div>

        <div class="login-card shadow-sm">
            <div class="drag-handle mb-4"></div>
            
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                
                <div class="form-group mb-4">
                    <label asp-for="Input.Username" class="form-label fw-bold">Nombre de Usuario</label>
                    <div class="input-group-custom">
                        <span class="input-icon"><i class="bi bi-person"></i></span>
                        <input asp-for="Input.Username" class="form-control-custom" placeholder="ej: juanperez123" />
                    </div>
                    <span asp-validation-for="Input.Username" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Input.Password" class="form-label fw-bold mb-0">Contraseña</label>
                    <div class="input-group-custom">
                        <span class="input-icon"><i class="bi bi-lock"></i></span>
                        <input asp-for="Input.Password" type="password" class="form-control-custom password-field" placeholder="••••••••" />
                        <span class="input-icon-end toggle-password" style="cursor: pointer;"><i class="bi bi-eye-slash"></i></span>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label fw-bold mb-0">Confirmar Contraseña</label>
                    <div class="input-group-custom">
                        <span class="input-icon"><i class="bi bi-shield-lock"></i></span>
                        <input asp-for="Input.ConfirmPassword" type="password" class="form-control-custom password-field" placeholder="••••••••" />
                        <span class="input-icon-end toggle-password" style="cursor: pointer;"><i class="bi bi-eye-slash"></i></span>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-login w-100 mb-4">
                    Registrarse <i class="bi bi-person-plus ms-2"></i>
                </button>

                <div class="text-center">
                    <p class="mb-0 register-text">¿Ya tienes una cuenta? <a asp-page="/Account/Login" class="register-link fw-bold">Iniciar Sesión</a></p>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/login-toggle.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
