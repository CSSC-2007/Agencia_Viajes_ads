@page
@model Agencia_Viajes_ADS.Pages.FinanzasModel
@{
    ViewData["Title"] = "Reportes Financieros";
}

<link rel="stylesheet" href="~/css/finanzas.css" asp-append-version="true" />

<div class="container-fluid p-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h3 mb-1 fw-bold">Reportes Financieros</h1>
            <p class="text-muted mb-0">Resumen del rendimiento económico de ExploraMundo</p>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="icon-bg bg-orange-light p-2 rounded">
                        <i class="bi bi-wallet2 text-orange"></i>
                    </div>
                    <span class="text-success fw-bold">+@Model.CrecimientoMensual.ToString("F1")%</span>
                </div>
                <p class="text-muted mb-1 small">Ingresos Totales</p>
                <h2 class="fw-bold mb-1">$@Model.IngresosTotales.ToString("N2")</h2>
                <p class="text-muted small mb-0"><i class="bi bi-clock"></i> Cálculo basado en pagos confirmados</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="icon-bg bg-green-light p-2 rounded">
                        <i class="bi bi-graph-up-arrow text-green"></i>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" checked disabled>
                    </div>
                </div>
                <p class="text-muted mb-1 small">Crecimiento Mensual</p>
                <h2 class="fw-bold mb-1">@Model.CrecimientoMensual.ToString("F1")%</h2>
                <div class="progress mt-2" style="height: 6px;">
                    <div class="progress-bar bg-success" style="width: @Math.Min(100, (int)Model.CrecimientoMensual)%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="icon-bg bg-red-light p-2 rounded">
                        <i class="bi bi-clipboard-check text-red"></i>
                    </div>
                    <span class="badge bg-red-light text-red rounded-pill">@Model.CantidadFacturasPendientes facturas</span>
                </div>
                <p class="text-muted mb-1 small">Pagos Pendientes</p>
                <h2 class="fw-bold mb-1">$@Model.PagosPendientes.ToString("N2")</h2>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <!-- Income Chart -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="fw-bold mb-0">Ingresos por Mes</h5>
                        <p class="text-muted small mb-0">Flujo de caja comparativo @DateTime.Now.Year</p>
                    </div>
                    <div class="d-flex gap-3 small">
                        <span class="d-flex align-items-center gap-1"><i class="bi bi-circle-fill text-orange fs-xs"></i> ACTUAL</span>
                        <span class="d-flex align-items-center gap-1 text-muted"><i class="bi bi-circle-fill text-light-gray fs-xs"></i> PREVIO</span>
                    </div>
                </div>
                <div style="height: 300px;">
                    <canvas id="incomeChart"></canvas>
                </div>
            </div>
        </div>
        <!-- Sales by Destination Chart -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h5 class="fw-bold mb-1">Ventas por Destino</h5>
                <p class="text-muted small mb-4">Distribución porcentual de reservas</p>
                <div class="position-relative d-flex justify-content-center mb-4">
                    <canvas id="destinationChart"></canvas>
                    <div class="position-absolute top-50 start-50 translate-middle text-center">
                        <h3 class="fw-bold mb-0">@Model.VentasPorDestino.Sum(x => x.Cantidad)</h3>
                        <p class="text-muted small mb-0">TOTAL TOURS</p>
                    </div>
                </div>
                <div class="mt-auto">
                    @foreach (var dest in Model.VentasPorDestino)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small"><i class="bi bi-circle-fill me-2" style="color: @GetColorForDest(dest.Destino)"></i> @dest.Destino</span>
                            <span class="fw-bold small">@(Model.VentasPorDestino.Sum(x => x.Cantidad) > 0 ? (dest.Cantidad * 100 / Model.VentasPorDestino.Sum(x => x.Cantidad)) : 0)%</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Transactions Table -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Transacciones Recientes</h5>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="text-muted small">
                            <tr>
                                <th>CLIENTE</th>
                                <th>PAQUETE / TOUR</th>
                                <th>FECHA</th>
                                <th>MONTO</th>
                                <th>ESTADO</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trans in Model.TransaccionesRecientes)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar bg-light text-orange fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                @GetInitials(trans.Cliente)
                                            </div>
                                            <div>
                                                <div class="fw-bold">@trans.Cliente</div>
                                                <div class="text-muted small">Factura: #@trans.Factura</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@trans.Paquete</td>
                                    <td>@trans.Fecha.ToString("dd MMM, yyyy")</td>
                                    <td class="fw-bold">$@trans.Monto.ToString("N2")</td>
                                    <td>
                                        <span class="badge @GetBadgeClass(trans.Estado) rounded-pill">@trans.Estado.ToUpper()</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <p class="text-muted small mb-0">Mostrando @Model.TransaccionesRecientes.Count de @Model.TransaccionesRecientes.Count transacciones</p>
                </div>
            </div>
        </div>
    </div>
    <!-- REPORTE GERENTE: PAGOS EN CUOTAS Y CLIENTES FRECUENTES -->
    <div class="row mt-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4">
                <h5 class="fw-bold mb-3 text-orange">Pagos en Cuotas</h5>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead class="text-muted small">
                            <tr>
                                <th>CLIENTE</th>
                                <th>TOUR</th>
                                <th>CUOTAS</th>
                                <th>MONTO</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.PagosEnCuotas.Any())
                            {
                                <tr><td colspan="4" class="text-center small">No hay pagos en cuotas</td></tr>
                            }
                            @foreach (var p in Model.PagosEnCuotas)
                            {
                                <tr>
                                    <td>@p.Cliente</td>
                                    <td>@p.Tour</td>
                                    <td class="text-center"><span class="badge bg-warning text-dark">@p.Cuotas</span></td>
                                    <td class="fw-bold">$@p.Monto.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-success">Clientes Frecuentes</h5>
                    <form method="get" class="d-flex align-items-center gap-2">
                        <span class="small text-muted">Más de:</span>
                        <input type="number" name="MinimoViajes" value="@Model.MinimoViajes" class="form-control form-control-sm" style="width: 60px;" />
                        <button type="submit" class="btn btn-sm btn-success">Ver</button>
                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead class="text-muted small">
                            <tr>
                                <th>CLIENTE</th>
                                <th>CANTIDAD VIAJES</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ClientesFrecuentes.Any())
                            {
                                <tr><td colspan="2" class="text-center small">No hay clientes con múltiples viajes</td></tr>
                            }
                            @foreach (var c in Model.ClientesFrecuentes)
                            {
                                <tr>
                                    <td>@c.Cliente</td>
                                    <td class="text-center fw-bold text-success">@c.CantidadViajes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- REPORTE GERENTE: CAPACIDAD DE TOURS -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm p-4">
                <h5 class="fw-bold mb-3">Informe de Ocupación de Tours</h5>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="text-muted small">
                            <tr>
                                <th>TOUR</th>
                                <th>PLAZAS TOTALES</th>
                                <th>PLAZAS OCUPADAS</th>
                                <th>PLAZAS DISPONIBLES</th>
                                <th>OCUPACIÓN %</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.ReporteCapacidad)
                            {
                                var porcentaje = t.PlazasTotales > 0 ? (t.PlazasOcupadas * 100 / t.PlazasTotales) : 0;
                                <tr>
                                    <td>@t.NombreTour</td>
                                    <td>@t.PlazasTotales</td>
                                    <td>@t.PlazasOcupadas</td>
                                    <td class="@(t.PlazasDisponibles < 5 ? "text-danger fw-bold" : "")">@t.PlazasDisponibles</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 8px;">
                                                <div class="progress-bar @(porcentaje > 80 ? "bg-danger" : "bg-warning")" style="width: @porcentaje%"></div>
                                            </div>
                                            <span class="small fw-bold">@porcentaje%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Income Chart
        const incomeCtx = document.getElementById('incomeChart').getContext('2d');
        new Chart(incomeCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.IngresosPorMes.Select(m => m.Mes))),
                datasets: [{
                    label: 'Actual',
                    data: @Html.Raw(Json.Serialize(Model.IngresosPorMes.Select(m => m.Monto))),
                    backgroundColor: '#f39c12',
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { drawBorder: false },
                        ticks: {
                            callback: function(value) { return '$' + value; }
                        }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // Destination Chart
        const destCtx = document.getElementById('destinationChart').getContext('2d');
        new Chart(destCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.VentasPorDestino.Select(d => d.Destino))),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.VentasPorDestino.Select(d => d.Cantidad))),
                    backgroundColor: ['#f39c12', '#e67e22', '#f1c40f'],
                    borderWidth: 0,
                    cutout: '80%'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                }
            }
        });
    </script>
}

@functions {
    public string GetBadgeClass(string estado)
    {
        return estado.ToLower() switch
        {
            "activa" => "bg-success-light text-success",
            "completado" => "bg-success-light text-success",
            "pendiente" => "bg-warning-light text-warning",
            "cancelada" => "bg-danger-light text-danger",
            _ => "bg-light text-muted"
        };
    }

    public string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "??";
        var parts = name.Split(' ');
        if (parts.Length >= 2) return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    public string GetColorForDest(string dest)
    {
        var colors = new[] { "#f39c12", "#e67e22", "#f1c40f", "#d35400" };
        var index = Math.Abs(dest.GetHashCode()) % colors.Length;
        return colors[index];
    }
}
