@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold">Resumen del Sistema</h2>
            <p class="text-muted">Bienvenido al panel de administración de ExploraMundo.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card-custom">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Ventas Hoy</p>
                        <h3 class="fw-bold mb-0">$1,240</h3>
                    </div>
                    <div class="bg-light-orange p-3 rounded-circle">
                        <i class="bi bi-graph-up text-warning fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-custom">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Nuevos Clientes</p>
                        <h3 class="fw-bold mb-0">12</h3>
                    </div>
                    <div class="bg-light-blue p-3 rounded-circle">
                        <i class="bi bi-person-plus text-primary fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-custom">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Reservas Activas</p>
                        <h3 class="fw-bold mb-0">45</h3>
                    </div>
                    <div class="bg-light-green p-3 rounded-circle">
                        <i class="bi bi-calendar-event text-success fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-custom">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Tours Próximos</p>
                        <h3 class="fw-bold mb-0">8</h3>
                    </div>
                    <div class="bg-light-red p-3 rounded-circle">
                        <i class="bi bi-map text-danger fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card-custom">
                <h5 class="fw-bold mb-4">Últimas Inscripciones</h5>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Cliente</th>
                                <th>Tour</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th>Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Carlos Alvarenga</td>
                                <td>Ruta de las Flores</td>
                                <td>28/04/2026</td>
                                <td><span class="badge bg-success">Confirmada</span></td>
                                <td>$45.00</td>
                            </tr>
                            <tr>
                                <td>Ana Martínez</td>
                                <td>Lago de Coatepeque</td>
                                <td>29/04/2026</td>
                                <td><span class="badge bg-warning text-dark">Pendiente</span></td>
                                <td>$30.00</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-light-orange { background-color: #fff3e0; }
    .bg-light-blue { background-color: #e3f2fd; }
    .bg-light-green { background-color: #e8f5e9; }
    .bg-light-red { background-color: #ffebee; }
</style>
