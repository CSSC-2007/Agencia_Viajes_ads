@page
@model Agencia_Viajes_ADS.Pages.ReservasModel

@{
    ViewData["Title"] = "Reservaciones";
}

<link rel="stylesheet" href="~/css/reservas.css" />

<div class="reservas-container">

    <div class="overlay"></div>

    <div class="contenido">

        <div class="reserva-card">

            <h1>Reservaciones</h1>

            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success mt-2">@TempData["Exito"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger mt-2">@TempData["Error"]</div>
            }

            <p class="cliente">
                Usuario: <strong>@Model.NombreUsuario</strong>
            </p>

            <form method="post">

                <div class="campo">
                    <label>Cliente</label>
                    <select asp-for="IdCliente" class="form-control">
                        <option value="">-- Selecciona cliente --</option>
                        @foreach (var cliente in Model.Clientes)
                        {
                            <option value="@cliente.IdCliente">
                                @cliente.Nombre
                            </option>
                        }
                    </select>
                </div>

                <div class="campo">
                    <label>Tour</label>
                    <select asp-for="IdTour" class="form-control">
                        @foreach (var tour in Model.Tours)
                        {
                            <option value="@tour.IdTour">
                                @tour.NombreTour ($@tour.Precio:N2)
                            </option>
                        }
                    </select>
                </div>

                <div class="campo">
                    <label>Monto</label>
                    <input asp-for="Monto" />
                </div>

                <div class="campo">
                    <label>Método Pago</label>
                    <select asp-for="MetodoPago">
                        <option>Efectivo</option>
                        <option>Tarjeta</option>
                        <option>Cuotas</option>
                    </select>
                </div>

                <div class="campo">
                    <label>Cuotas</label>
                    <input asp-for="Cuotas" />
                </div>

                <div class="campo">
                    <label>Factura</label>
                    <input asp-for="Factura" />
                </div>

                <div asp-validation-summary="All" class="text-danger"></div>

                <button type="submit" class="btn-guardar">
                    Guardar Reserva
                </button>

            </form>

        </div>

        <div class="tabla-card">

            <h2>Mis Reservas</h2>

            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Cliente</th>
                        <th>Tour</th>
                        <th>Monto</th>
                        <th>Estado</th>
                        <th>Fecha registro</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reserva in Model.ReservasCliente)
                    {
                        <tr>
                            <td>@reserva.IdInscripcion</td>
                            <td>@reserva.NombreCliente</td>
                            <td>@reserva.NombreTour</td>
                            <td>@reserva.Pago</td>
                            <td>@reserva.Estado</td>
                            <td>@reserva.FechaInscripcion.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (reserva.Estado != "Cancelada")
                                {
                                    <form method="post" asp-page-handler="Cancelar" asp-route-id="@reserva.IdInscripcion" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Dar de baja?')">Baja</button>
                                    </form>
                                    <button class="btn btn-sm btn-warning" onclick="abrirEditarPago('@reserva.IdInscripcion', '@reserva.MetodoPago', '@reserva.Cuotas', '@reserva.Pago')">Pago</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>

    </div>

</div>

<!-- MODAL EDITAR PAGO -->
<div class="modal fade" id="modalEditarPago" tabindex="-1" style="color: black;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Modificar Forma de Pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="ModificarPago">
                <div class="modal-body">
                    <input type="hidden" asp-for="IdInscripcionEdit" id="editIdInscripcion" />
                    <div class="mb-3">
                        <label class="form-label">Monto Total Pagado</label>
                        <input asp-for="MontoEdit" id="editMonto" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Método Pago</label>
                        <select asp-for="MetodoPagoEdit" id="editMetodoPago" class="form-control">
                            <option>Efectivo</option>
                            <option>Tarjeta</option>
                            <option>Cuotas</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cuotas</label>
                        <input asp-for="CuotasEdit" id="editCuotas" class="form-control" type="number" min="1" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-primary">Actualizar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function abrirEditarPago(id, metodo, cuotas, monto) {
        document.getElementById('editIdInscripcion').value = id;
        document.getElementById('editMetodoPago').value = metodo;
        document.getElementById('editCuotas').value = cuotas;
        document.getElementById('editMonto').value = monto;
        new bootstrap.Modal(document.getElementById('modalEditarPago')).show();
    }
</script>