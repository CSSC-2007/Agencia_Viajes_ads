<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExploraMundo</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <a class="logo-container" asp-page="/Index">
                    <i class="bi bi-compass-fill me-2"></i>
                    <span>ExploraMundo</span>
                </a>
            </div>

            <ul class="list-unstyled components">
                <li class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">
                    <a asp-page="/Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
                <li class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Paquetes" ? "active" : "")">
                    <a asp-page="/Paquetes">
                        <i class="bi bi-box-seam"></i> Mis Paquetes
                    </a>
                </li>
                <li class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Clientes" ? "active" : "")">
                    <a asp-page="/Clientes">
                        <i class="bi bi-people"></i> Clientes
                    </a>
                </li>
                <li class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Reservas" ? "active" : "")">
                    <a asp-page="/Reservas">
                        <i class="bi bi-calendar-check"></i> Reservas
                    </a>
                </li>
                <li class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Finanzas" ? "active" : "")">
                    <a asp-page="/Finanzas">
                        <i class="bi bi-cash-stack"></i> Finanzas
                    </a>
                </li>
                <li class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Configuracion" ? "active" : "")">
                    <a asp-page="/Configuracion">
                        <i class="bi bi-gear"></i> Configuración
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Page Content -->
        <div id="content">
            <nav class="navbar-custom d-flex justify-content-end align-items-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-profile">
                        <span class="fw-bold">@User.Identity.Name</span>
                        <div class="vr"></div>
                        <form method="post" asp-page="/Account/Logout" class="d-inline">
                            <button type="submit" class="logout-btn btn btn-link p-0 border-0">Cerrar Sesión</button>
                        </form>
                    </div>
                }
                else
                {
                    <a asp-page="/Account/Login" class="btn btn-outline-primary btn-sm">Iniciar Sesión</a>
                }
            </nav>

            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
